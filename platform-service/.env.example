# Autonomous DevOps Platform - Environment Configuration

# Server
PORT=4000
NODE_ENV=development

# Storage & Upload Limits (Default 1024MB / 1GB)
MAX_UPLOAD_SIZE_MB=1024
TEMPORARY_DIR=temporary/projects

# Session Configuration (Persistent auth default 3 days)
SESSION_TTL_DAYS=3

# Docker Engine
DOCKER_BUILD_TIMEOUT_MS=120000
CONTAINER_MEMORY_LIMIT=512m
CONTAINER_CPU_LIMIT=1.0
HEALTH_CHECK_RETRIES=10
HEALTH_CHECK_INTERVAL_MS=1000

# GitHub Integration (Phase 4)
GITHUB_TOKEN=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:4000/api/github/auth/callback

# Jenkins CI/CD Engine (Phase 4)
JENKINS_URL=http://127.0.0.1:8080
JENKINS_USERNAME=jaswanth15
JENKINS_API_TOKEN=password

# Kubernetes Engine (Phase 5)
KIND_CLUSTER_NAME=cloudops-local
KUBERNETES_CONTEXT=kind-cloudops-local
KUBERNETES_NAMESPACE_PREFIX=cloudops-

# AWS Cloud Deployment Engine (Phase 6)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_DEFAULT_INSTANCE_TYPE=t3.micro
AWS_DEFAULT_ARM_INSTANCE_TYPE=t4g.micro
AWS_SECURITY_GROUP_NAME=cloudops-app-sg
AWS_IAM_ROLE_NAME=CloudOpsEC2SSMRole
AWS_INSTANCE_PROFILE_NAME=CloudOpsEC2SSMInstanceProfile

# Google Authentication (OAuth 2.0 / OpenID Connect)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# MongoDB Database (Optional - falls back to local storage if not configured)
MONGODB_URI=mongodb://localhost:27017/cloudops
MONGODB_DB_NAME=cloudops
